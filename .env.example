# 複製為 .env 後填入實際值：cp .env.example .env
# .env 已列入 .gitignore，請勿 commit

# SonarQube 資料庫帳密（僅在 postgres volume 首次初始化時生效）
POSTGRES_USER=sonar
POSTGRES_PASSWORD=change-me

# Jenkins agent：在 Jenkins「管理 Jenkins → Nodes」建立節點後取得 secret
JENKINS_AGENT_NAME=main-agent
JENKINS_AGENT_SECRET=change-me

# 主機 docker.sock 所屬群組 GID，讓 jenkins 使用者有權限存取
# Linux：getent group docker | cut -d: -f3
# Docker Desktop（macOS / Windows）：0
DOCKER_GID=0
